{
  "name": "@keyobject/aws-kms-@TARGET@",
  "version": "@VERSION@",
  "description": "Prebuilt OpenSSL provider for @keyobject/aws-kms on @TARGET@",
  "homepage": "https://github.com/panva/keyobject-aws-kms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panva/keyobject-aws-kms.git",
    "directory": "npm/platform"
  },
  "funding": {
    "url": "https://github.com/sponsors/panva"
  },
  "license": "MIT",
  "author": "Filip Skokan <panva.ip@gmail.com>",
  "engines": {
    "node": ">=26.7.0"
  },
  "os": ["@OS@"],
  "cpu": ["@CPU@"],
  "libc": @LIBC@,
  "files": [
    "@MODULE@",
    "awskms.cnf",
    "THIRD_PARTY_NOTICES.md",
    "third_party/"
  ],
  "exports": {
    "./@MODULE@": "./@MODULE@",
    "./awskms.cnf": "./awskms.cnf",
    "./package.json": "./package.json"
  },
  "bugs": {
    "url": "https://github.com/panva/keyobject-aws-kms/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
