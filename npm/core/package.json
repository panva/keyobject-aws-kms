{
  "name": "@keyobject/aws-kms",
  "version": "0.0.1",
  "description": "AWS KMS asymmetric signing keys as Node.js KeyObject instances",
  "keywords": [
    "aws",
    "aws-kms",
    "crypto",
    "cryptography",
    "ecdsa",
    "ed25519",
    "fips",
    "keyobject",
    "kms",
    "ml-dsa",
    "node",
    "nodejs",
    "openssl",
    "openssl-provider",
    "rsa",
    "sign",
    "signature",
    "webcrypto"
  ],
  "homepage": "https://github.com/panva/keyobject-aws-kms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panva/keyobject-aws-kms.git",
    "directory": "npm/core"
  },
  "funding": {
    "url": "https://github.com/sponsors/panva"
  },
  "license": "MIT",
  "author": "Filip Skokan <panva.ip@gmail.com>",
  "sideEffects": [
    "./register.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./register": {
      "types": "./register.d.ts",
      "default": "./register.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "bin": {
    "keyobject-aws-kms": "./bin/awskms.js"
  },
  "files": [
    "index.js",
    "register.js",
    "register.d.ts",
    "index.d.ts",
    "bin/",
    "check.mjs"
  ],
  "engines": {
    "node": ">=26.7.0"
  },
  "optionalDependencies": {
    "@keyobject/aws-kms-darwin-arm64": "0.0.1",
    "@keyobject/aws-kms-linux-arm64": "0.0.1",
    "@keyobject/aws-kms-linux-x64": "0.0.1",
    "@keyobject/aws-kms-linuxmusl-arm64": "0.0.1",
    "@keyobject/aws-kms-linuxmusl-x64": "0.0.1"
  },
  "bugs": {
    "url": "https://github.com/panva/keyobject-aws-kms/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
